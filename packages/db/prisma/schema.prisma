generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String        @id @default(uuid())
  email       String        @unique
  password    String
  name        String?
  avatarUrl   String?
  role        UserRole      @default(MEMBER)
  onboardingCompleted Boolean @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships Membership[]
  comments    Comment[]
  assignedIssues Issue[]    @relation("IssueAssignees")
  createdRuns AgentRun[]   @relation("RunCreatedBy")
  runApprovals RunApproval[] @relation("ApprovalDecidedBy")

}

model Organization {
  id          String        @id @default(uuid())
  name        String
  description String?
  orgImage    String?
  slug        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  memberships Membership[]
  boards      Board[]
  invitations Invitation[]
  agentConfig  OrganizationAgentConfig?
  agentRuns    AgentRun[]
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           UserRole     @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([email])
}

model Membership {
  id              String       @id @default(uuid())
  userId          String
  organizationId  String
  role            UserRole     @default(MEMBER)
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Board {
  id              String       @id @default(uuid())
  title           String
  description     String?
  organizationId  String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections        Section[]
  defaultRepository String?

  @@index([organizationId])
}

model Section {
  id          String        @id @default(uuid())
  title       String
  order       Int           @default(0)
  boardId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  issues      Issue[]

  @@index([boardId])
}

model Issue {
  id          String        @id @default(uuid())
  title       String
  description String?
  order       Int           @default(0)
  priority    IssuePriority @default(NONE)
  dueDate     DateTime?
  sectionId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  section     Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  comments    Comment[]
  assignees   User[]        @relation("IssueAssignees")
  agentRuns   AgentRun[]
  repository  String?

  @@index([sectionId])
}

model Comment {
  id          String        @id @default(uuid())
  content     String
  issueId     String
  authorId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  issue       Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

enum UserRole {
  MEMBER
  ADMIN
  MODERATOR
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AgentEngine {
  CODEX
  CLAUDE_CODE
  OPENCODE
  PI
}

enum RunExecutionMode {
  IMPLEMENT
  PLAN_AND_APPROVE
}

enum RunStatus {
  QUEUED
  PROVISIONING
  PLANNING
  AWAITING_APPROVAL
  IMPLEMENTING
  VALIDATING
  REVIEWING
  PUBLISHING
  COMPLETED
  BLOCKED
  LIMIT_REACHED
  FAILED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model OrganizationAgentConfig {
  id                   String           @id @default(uuid())
  organizationId       String           @unique
  allowedRepositories  String[]
  defaultEngine        AgentEngine?
  defaultModel         String?
  defaultExecutionMode RunExecutionMode @default(IMPLEMENT)
  runBudgetUsd         Float            @default(5)
  dailyOrgBudgetUsd    Float            @default(25)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id             String           @id @default(uuid())
  issueId        String
  organizationId String
  createdBy      String
  engine         AgentEngine
  model          String
  options        Json             @default("{}")
  executionMode  RunExecutionMode @default(IMPLEMENT)
  repository     String
  baseCommit     String?
  branchName     String
  status         RunStatus        @default(QUEUED)
  activeIssueId  String?          @unique
  planVersion    Int              @default(0)
  owner          String?
  leaseExpiresAt DateTime?
  fencingToken   Int              @default(0)
  idempotencyKey String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  issue           Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("RunCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  events          RunEvent[]
  approvals       RunApproval[]

  @@unique([organizationId, idempotencyKey])
  @@index([issueId])
  @@index([organizationId, status])
}

model RunEvent {
  id        String   @id @default(uuid())
  runId     String
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId])
}

model RunApproval {
  id          String           @id @default(uuid())
  runId       String
  planVersion Int
  decision    ApprovalDecision
  baseCommit  String
  decidedBy   String
  decidedAt   DateTime         @default(now())

  run           AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedByUser User     @relation("ApprovalDecidedBy", fields: [decidedBy], references: [id], onDelete: Cascade)

  @@unique([runId, planVersion])
  @@index([runId])
}
